    "dev:emulated": "node scripts/dev-emulated.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-tools": "^13.35.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
