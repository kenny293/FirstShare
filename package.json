{
  "name": "firstshare",
  "version": "0.1.0",
  "private": true,
  "description": "FirstShare - an educational investing simulator for complete beginners",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "data:sample": "node scripts/generate-sample-data.mjs",
    "data:fetch": "python scripts/fetch-data.py",
