rules_version = '2';

// The browser never reads or writes Firestore directly. All access goes
// through FirstShare's server API (Firebase Admin SDK, which bypasses these
// rules) after verifying the player's sign-in token. That keeps scores and
// leaderboard entries tamper-proof.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
