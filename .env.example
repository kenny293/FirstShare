# Copy this file to .env.local (or .env) and fill in what you need.

# --- Google Gemini (AI coach; server-side only, never prefix with NEXT_PUBLIC_) ---
GEMINI_API_KEY=
# Optional: main model (see which ones your key can use with `npm run gemini:models`)
GEMINI_MODEL=gemini-3.8-flash
# Optional: model tried if the main one is still busy after one retry. "none" disables it.
GEMINI_BACKUP_MODEL=none
# Optional: total time budget for all Gemini attempts before using a fallback tip (ms)
GEMINI_TIMEOUT_MS=30000

# --- Firebase web app (sign-in in the browser) ---
# Firebase console > Project settings > Your apps > Web app config.
# These are meant to be public: they identify the project; security comes from
# sign-in + server checks + Firestore rules (firestore.rules denies browser access).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only: verifies sign-ins, reads/writes Firestore) ---
# Firebase console > Project settings > Service accounts > Generate new private key.
# Either paste the whole JSON on one line...
FIREBASE_SERVICE_ACCOUNT_JSON=
# ...or set these three (keep the \n sequences in the private key):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Alpaca Market Data (live challenge prices; server only) ---
# alpaca.markets > sign up (free) > API keys. Without these the challenge uses the local /data snapshot.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Optional: "iex" works on the free plan; "sip" needs a paid plan.
ALPACA_FEED=iex
